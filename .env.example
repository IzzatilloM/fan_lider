DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost,.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://*.pythonanywhere.com

# Ma'lumotlar bazasi: sqlite (default) yoki postgres
DB_ENGINE=sqlite
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

BRAND_NAME=Fan Lider

# Rollar cheklovi. Admin/direktor o'zini Telegram orqali ro'yxatdan o'tkazadi.
MAX_ADMINS=2
MAX_DIRECTORS=1

# Telegram tasdiqlash kodi sozlamalari (ro'yxatdan o'tish / parol tiklash)
TG_CODE_TTL_MINUTES=10
TG_CODE_MAX_ATTEMPTS=5
TG_CODE_RESEND_SECONDS=60

# Suniy intellekt (oylik tahlili) — Anthropic Claude (ixtiyoriy).
# Bo'sh bo'lsa AI mahalliy (offline) rejimda ishlaydi.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Telegram bot (ixtiyoriy) — @BotFather token, sayt manzili.
# Sozlangach: python manage.py set_telegram_webhook
TELEGRAM_BOT_TOKEN=8479550724:AAGVb7-mh0YZkO6EzUigMXVmVCVK4MC2vfk
TELEGRAM_WEBHOOK_SECRET=fanlider-webhook-2026
